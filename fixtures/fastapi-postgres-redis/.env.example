APP_IMAGE=deploy-skills-fastapi-redis
APP_VERSION=0.1.0
HTTP_PORT=8080
APP_PORT=18001
POSTGRES_PORT=15433
REDIS_PORT=16379
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-secret-store-value
DATABASE_URL=postgresql+psycopg://app:replace-with-secret-store-value@db:5432/app
REDIS_PASSWORD=replace-with-separate-secret-store-value
REDIS_URL=redis://:replace-with-separate-secret-store-value@redis:6379/0
